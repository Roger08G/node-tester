{
  "name": "@roger08g/node-tester",
  "version": "1.0.0",
  "description": "A production-focused Node.js test CLI powered by a Rust execution engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "node-tester": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "assets",
    "dist",
    "native/*.node",
    "runtime",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run build:native && bun run build:ts",
    "build:native": "napi build --platform --release --manifest-path rust/node-addon/Cargo.toml --output-dir native --no-js --dts generated.d.ts -- --locked",
    "build:native:debug": "napi build --platform --manifest-path rust/node-addon/Cargo.toml --output-dir native --no-js --dts generated.d.ts -- --locked",
    "build:ts": "bun run clean && tsc -p tsconfig.json",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "audit:rust": "cargo audit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:rust && bun run test:ts",
    "test:rust": "cargo test --workspace --locked",
    "test:ts": "bun run build:ts && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "benchmark": "bun run build && node benchmark/benchmark.mjs",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "bun run build:ts && bun run package:check"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "author": "Roger08G",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roger08G/node-tester.git"
  },
  "homepage": "https://github.com/Roger08G/node-tester#readme",
  "bugs": {
    "url": "https://github.com/Roger08G/node-tester/issues"
  },
  "keywords": [
    "node",
    "node-test",
    "rust",
    "test-runner",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "napi": {
    "binaryName": "node-tester-engine",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@types/node": "^22.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
